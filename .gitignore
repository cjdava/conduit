# .gitignore for .NET projects
# Build results
bin/
obj/

# User-specific files
*.user
*.suo
*.userosscache
*.sln.docstates

# Rider/VSCode/JetBrains
.idea/
.vscode/
*.sln.iml

# OS generated files
.DS_Store
Thumbs.db

# Logs
*.log

# Test results
TestResults/

# Others
*.swp
*.bak
*.tmp
*.orig

# NuGet
*.nupkg
.nuget/

# Benchmark CSV data files (generate with scripts/generate_csv.py)
Conduit/data/*.csv
